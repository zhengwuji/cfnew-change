}

async function handleWsRequest(request) {
    try {
        console.log('[WS-DEBUG] WebSocket request received');

        // 检测并设置当前Worker地区，确保WebSocket请求能正确进行就近匹配
        if (!currentWorkerRegion || currentWorkerRegion === '') {
            if (manualWorkerRegion && manualWorkerRegion.trim()) {
                currentWorkerRegion = manualWorkerRegion.trim().toUpperCase();
            } else {
                currentWorkerRegion = await detectWorkerRegion(request);
            }
        }
        console.log('[WS-DEBUG] Worker region:', currentWorkerRegion);
        console.log('[WS-DEBUG] ev (VLESS enabled):', ev);
        console.log('[WS-DEBUG] et (Trojan enabled):', et);
        console.log('[WS-DEBUG] ex (xhttp enabled):', ex);
        console.log('[WS-DEBUG] UUID (at):', at);

        const wsPair = new WebSocketPair();
        const [clientSock, serverSock] = Object.values(wsPair);
        serverSock.accept();
        console.log('[WS-DEBUG] WebSocket pair created and accepted');

        let remoteConnWrapper = { socket: null };
        let isDnsQuery = false;
        let protocolType = null;
        let firstChunkReceived = false;

        const earlyData = request.headers.get(atob('c2VjLXdlYnNvY2tldC1wcm90b2NvbA==')) || '';
        console.log('[WS-DEBUG] Early data header length:', earlyData.length);
        const readable = makeReadableStream(serverSock, earlyData);

        // 添加 WebSocket 事件监听器用于调试
        serverSock.addEventListener('close', (event) => {
            console.log('[WS-DEBUG] WebSocket closed, code:', event.code, 'reason:', event.reason);
        });

        serverSock.addEventListener('error', (error) => {
            console.log('[WS-DEBUG] WebSocket error:', error);
        });

        readable.pipeTo(new WritableStream({
            async write(chunk) {
                if (!firstChunkReceived) {
                    firstChunkReceived = true;
                    console.log('[WS-DEBUG] First chunk received, size:', chunk.byteLength, 'protocolType:', protocolType);
                }

                if (isDnsQuery) {
                    console.log('[WS-DEBUG] Forwarding UDP (DNS)');
                    return await forwardUDP(chunk, serverSock, null);
                }
                if (remoteConnWrapper.socket) {
                    console.log('[WS-DEBUG] Forwarding to established connection');
                    const writer = remoteConnWrapper.socket.writable.getWriter();
                    await writer.write(chunk);
                    writer.releaseLock();
                    return;
                }

                if (!protocolType) {
                    console.log('[WS-DEBUG] Protocol not detected yet, chunk size:', chunk.byteLength);

                    // 如果数据块太小（小于最小协议要求），等待更多数据
                    if (chunk.byteLength < 24) {
                        console.log('[WS-DEBUG] Chunk too small, waiting for more data');
                        return; // 等待更多数据，不抛出错误
                    }

                    // 尝试解析 VLESS 协议
                    if (ev && chunk.byteLength >= 24) {
                        console.log('[WS-DEBUG] Attempting VLESS parse, chunk size:', chunk.byteLength);
                        const vlessResult = parseWsPacketHeader(chunk, at);
                        console.log('[WS-DEBUG] VLESS parse result:', JSON.stringify({
                            hasError: vlessResult.hasError,
                            message: vlessResult.message || 'OK'
                        }));

                        if (!vlessResult.hasError) {
                            protocolType = 'vless';
                            console.log('[WS-DEBUG] VLESS protocol detected successfully');
                            const { addressType, port, hostname, rawIndex, version, isUDP } = vlessResult;
                            console.log('[WS-DEBUG] VLESS target:', hostname + ':' + port, 'UDP:', isUDP);

                            if (isUDP) {
                                if (port === 53) {
                                    isDnsQuery = true;
                                    console.log('[WS-DEBUG] UDP DNS query detected');
                                } else {
                                    // UDP 仅支持 DNS (端口 53)
                                    console.log('[WS-DEBUG] UDP non-DNS port rejected:', port);
                                    closeSocketQuietly(serverSock);
                                    return;
                                }
                            }
                            const respHeader = new Uint8Array([version[0], 0]);
                            const rawData = chunk.slice(rawIndex);
                            if (isDnsQuery) {
                                await forwardUDP(rawData, serverSock, respHeader);
                                return;
                            }
                            console.log('[WS-DEBUG] Forwarding TCP connection to:', hostname + ':' + port);
                            await forwardTCP(addressType, hostname, port, rawData, serverSock, respHeader, remoteConnWrapper);
                            return;
                        } else {
                            console.log('[WS-DEBUG] VLESS parse failed:', vlessResult.message);
                        }
                    }

                    // 尝试解析 Trojan 协议
                    if (et && chunk.byteLength >= 56) {
                        console.log('[WS-DEBUG] Attempting Trojan parse, chunk size:', chunk.byteLength);
                        const tjResult = await parseTrojanHeader(chunk, at);
                        console.log('[WS-DEBUG] Trojan parse result:', JSON.stringify({
                            hasError: tjResult.hasError,
                            message: tjResult.message || 'OK'
                        }));

                        if (!tjResult.hasError) {
                            protocolType = atob('dHJvamFu');
                            console.log('[WS-DEBUG] Trojan protocol detected successfully');
                            const { addressType, port, hostname, rawClientData } = tjResult;
                            console.log('[WS-DEBUG] Trojan target:', hostname + ':' + port);
                            await forwardTCP(addressType, hostname, port, rawClientData, serverSock, null, remoteConnWrapper);
                            return;
                        } else {
                            console.log('[WS-DEBUG] Trojan parse failed:', tjResult.message);
                        }
                    }

                    // 如果数据足够大但所有启用的协议都解析失败，可能是认证失败或协议不匹配
                    console.log('[WS-DEBUG] All protocol attempts failed, closing connection');
                    console.log('[WS-DEBUG] Chunk preview (first 32 bytes):', Array.from(new Uint8Array(chunk.slice(0, 32))).map(b => '0x' + b.toString(16).padStart(2, '0')).join(' '));
                    closeSocketQuietly(serverSock);
                    return;
                }

                console.log('[WS-DEBUG] Data forwarded to established connection');
            },
        })).catch((err) => {
            console.log('[WS-DEBUG] Stream error caught:', err.message, err.stack);
            logError(err, 'handleWsRequest.stream', {
                url: request.url,
                workerRegion: currentWorkerRegion || 'unknown'
            });
            // 静默处理错误，避免WebSocket连接被中断
        });

        console.log('[WS-DEBUG] Returning WebSocket response (101)');
        return new Response(null, {
            status: 101,
            webSocket: clientSock,
            headers: {
                'Upgrade': 'websocket',
                'Connection': 'Upgrade'
            }
        });
    } catch (error) {
        console.log('[WS-DEBUG] handleWsRequest error:', error.message, error.stack);
        logError(error, 'handleWsRequest', {
            url: request.url,
            method: request.method,
            workerRegion: currentWorkerRegion || 'unknown',
            statusCode: 500
        });
        // 如果WebSocket创建失败，返回错误响应
        return new Response(`WebSocket error: ${error.message}`, { status: 500 });
    }
}

async function forwardTCP(addrType, host, portNum, rawData, ws, respHeader, remoteConnWrapper) {
    async function connectAndSend(address, port, useSocks = false) {
        const remoteSock = useSocks ?
            await establishSocksConnection(addrType, address, port) :
            connect({ hostname: address, port: port });
        const writer = remoteSock.writable.getWriter();
        await writer.write(rawData);
        writer.releaseLock();
        return remoteSock;
    }

    async function retryConnection() {
        if (enableSocksDowngrade && isSocksEnabled) {
            try {
                const socksSocket = await connectAndSend(host, portNum, true);
                remoteConnWrapper.socket = socksSocket;
                socksSocket.closed.catch(() => { }).finally(() => closeSocketQuietly(ws));
                connectStreams(socksSocket, ws, respHeader, null);
                return;
            } catch (socksErr) {
                // 记录 SOCKS5 连接失败日志，方便排查 v2rayN 等客户端连接失败问题
                logError(socksErr, 'forwardTCP.retry.socks', {
                    targetHost: host,
                    targetPort: portNum,
                    workerRegion: currentWorkerRegion || 'unknown',
                    useSocks: true
                });
                let backupHost, backupPort;
                if (fallbackAddress && fallbackAddress.trim() && fallbackPort) {
                    backupHost = fallbackAddress;
                    backupPort = parseInt(fallbackPort, 10) || portNum;
                } else {
                    const bestBackupIP = await getBestBackupIP(currentWorkerRegion);
                    backupHost = bestBackupIP ? bestBackupIP.domain : host;
                    backupPort = bestBackupIP ? bestBackupIP.port : portNum;
                }

                try {
                    const fallbackSocket = await connectAndSend(backupHost, backupPort, false);
                    remoteConnWrapper.socket = fallbackSocket;
                    fallbackSocket.closed.catch(() => { }).finally(() => closeSocketQuietly(ws));
                    connectStreams(fallbackSocket, ws, respHeader, null);
                } catch (fallbackErr) {
                    // 记录降级到备用节点仍然失败的情况
                    logError(fallbackErr, 'forwardTCP.retry.fallback', {
                        targetHost: host,
                        targetPort: portNum,
                        fallbackHost,
                        fallbackPort,
                        workerRegion: currentWorkerRegion || 'unknown',
                        useSocks: false
                    });
                    closeSocketQuietly(ws);
                }
            }
        } else {
            let backupHost, backupPort;
            if (fallbackAddress && fallbackAddress.trim() && fallbackPort) {
                backupHost = fallbackAddress;
                backupPort = parseInt(fallbackPort, 10) || portNum;
            } else {
                const bestBackupIP = await getBestBackupIP(currentWorkerRegion);
                backupHost = bestBackupIP ? bestBackupIP.domain : host;
                backupPort = bestBackupIP ? bestBackupIP.port : portNum;
            }

            try {
                const fallbackSocket = await connectAndSend(backupHost, backupPort, isSocksEnabled);
                remoteConnWrapper.socket = fallbackSocket;
                fallbackSocket.closed.catch(() => { }).finally(() => closeSocketQuietly(ws));
                connectStreams(fallbackSocket, ws, respHeader, null);
            } catch (fallbackErr) {
                // 记录直接降级连接失败日志
                logError(fallbackErr, 'forwardTCP.retry.directFallback', {
                    targetHost: host,
                    targetPort: portNum,
                    fallbackHost,
                    fallbackPort,
                    workerRegion: currentWorkerRegion || 'unknown',
                    useSocks: isSocksEnabled
                });
                closeSocketQuietly(ws);
            }
        }
    }

    try {
        const initialSocket = await connectAndSend(host, portNum, enableSocksDowngrade ? false : isSocksEnabled);
        remoteConnWrapper.socket = initialSocket;
        connectStreams(initialSocket, ws, respHeader, retryConnection);
    } catch (err) {
        // 首次连接失败也记录日志（包括 v2rayN 等客户端直连失败场景）
        logError(err, 'forwardTCP.initialConnect', {
            targetHost: host,
            targetPort: portNum,
            workerRegion: currentWorkerRegion || 'unknown',
            useSocks: isSocksEnabled
        });
        retryConnection();
    }
}

function parseWsPacketHeader(chunk, token) {
    if (chunk.byteLength < 24) {
        console.log('[WS-DEBUG] parseWsPacketHeader: chunk too small', chunk.byteLength);
        return { hasError: true, message: E_INVALID_DATA };
    }
    const version = new Uint8Array(chunk.slice(0, 1));
    const chunkToken = formatIdentifier(new Uint8Array(chunk.slice(1, 17)));
    if (chunkToken !== token) {
        console.log('[WS-DEBUG] parseWsPacketHeader: token mismatch', 'expected:', token, 'got:', chunkToken);
        return { hasError: true, message: E_INVALID_USER };
    }
    const optLen = new Uint8Array(chunk.slice(17, 18))[0];
    const cmd = new Uint8Array(chunk.slice(18 + optLen, 19 + optLen))[0];
    let isUDP = false;
    if (cmd === 1) { } else if (cmd === 2) { isUDP = true; } else {
        console.log('[WS-DEBUG] parseWsPacketHeader: unsupported command', cmd);
        return { hasError: true, message: E_UNSUPPORTED_CMD };
    }
    const portIdx = 19 + optLen;
    const port = new DataView(chunk.slice(portIdx, portIdx + 2)).getUint16(0);
    let addrIdx = portIdx + 2, addrLen = 0, addrValIdx = addrIdx + 1, hostname = '';
    const addressType = new Uint8Array(chunk.slice(addrIdx, addrValIdx))[0];
    switch (addressType) {
        case ADDRESS_TYPE_IPV4: addrLen = 4; hostname = new Uint8Array(chunk.slice(addrValIdx, addrValIdx + addrLen)).join('.'); break;
        case ADDRESS_TYPE_URL: addrLen = new Uint8Array(chunk.slice(addrValIdx, addrValIdx + 1))[0]; addrValIdx += 1; hostname = new TextDecoder().decode(chunk.slice(addrValIdx, addrValIdx + addrLen)); break;
        case ADDRESS_TYPE_IPV6: addrLen = 16; const ipv6 = []; const ipv6View = new DataView(chunk.slice(addrValIdx, addrValIdx + addrLen)); for (let i = 0; i < 8; i++) ipv6.push(ipv6View.getUint16(i * 2).toString(16)); hostname = ipv6.join(':'); break;
        default:
            console.log('[WS-DEBUG] parseWsPacketHeader: invalid address type', addressType);
            return { hasError: true, message: `${E_INVALID_ADDR_TYPE}: ${addressType}` };
    }
    if (!hostname) {
        console.log('[WS-DEBUG] parseWsPacketHeader: empty hostname, addressType:', addressType);
        return { hasError: true, message: `${E_EMPTY_ADDR}: ${addressType}` };
    }
    return { hasError: false, addressType, port, hostname, isUDP, rawIndex: addrValIdx + addrLen, version };
}

function makeReadableStream(socket, earlyDataHeader) {
    let cancelled = false;
    return new ReadableStream({
        start(controller) {
            socket.addEventListener('message', (event) => { if (!cancelled) controller.enqueue(event.data); });
            socket.addEventListener('close', () => { if (!cancelled) { closeSocketQuietly(socket); controller.close(); } });
            socket.addEventListener('error', (err) => controller.error(err));
            const { earlyData, error } = base64ToArray(earlyDataHeader);
            if (error) controller.error(error); else if (earlyData) controller.enqueue(earlyData);
        },
        cancel() { cancelled = true; closeSocketQuietly(socket); }
    });
}

async function connectStreams(remoteSocket, webSocket, headerData, retryFunc) {
    let header = headerData, hasData = false;
    await remoteSocket.readable.pipeTo(
        new WritableStream({
            async write(chunk, controller) {
                hasData = true;
                if (webSocket.readyState !== 1) controller.error(E_WS_NOT_OPEN);
                if (header) { webSocket.send(await new Blob([header, chunk]).arrayBuffer()); header = null; }
                else { webSocket.send(chunk); }
            },
            abort(reason) { },
        })
    ).catch((error) => { closeSocketQuietly(webSocket); });
    if (!hasData && retryFunc) retryFunc();
}

async function forwardUDP(udpChunk, webSocket, respHeader) {
    try {
        const tcpSocket = connect({ hostname: '8.8.4.4', port: 53 });
        let header = respHeader;
        const writer = tcpSocket.writable.getWriter();
        await writer.write(udpChunk);
        writer.releaseLock();
        await tcpSocket.readable.pipeTo(new WritableStream({
            async write(chunk) {
                if (webSocket.readyState === 1) {
                    if (header) { webSocket.send(await new Blob([header, chunk]).arrayBuffer()); header = null; }
                    else { webSocket.send(chunk); }
                }
            },
        }));
    } catch (error) { }
}

async function establishSocksConnection(addrType, address, port) {
    const { username, password, hostname, socksPort } = parsedSocks5Config;
    const socket = connect({ hostname, port: socksPort });
    const writer = socket.writable.getWriter();
    await writer.write(new Uint8Array(username ? [5, 2, 0, 2] : [5, 1, 0]));
    const reader = socket.readable.getReader();
    let res = (await reader.read()).value;
    if (res[0] !== 5 || res[1] === 255) throw new Error(E_SOCKS_NO_METHOD);
    if (res[1] === 2) {
        if (!username || !password) throw new Error(E_SOCKS_AUTH_NEEDED);
        const encoder = new TextEncoder();
        const authRequest = new Uint8Array([1, username.length, ...encoder.encode(username), password.length, ...encoder.encode(password)]);
        await writer.write(authRequest);
        res = (await reader.read()).value;
        if (res[0] !== 1 || res[1] !== 0) throw new Error(E_SOCKS_AUTH_FAIL);
    }
    const encoder = new TextEncoder(); let DSTADDR;
    switch (addrType) {
        case ADDRESS_TYPE_IPV4: DSTADDR = new Uint8Array([1, ...address.split('.').map(Number)]); break;
        case ADDRESS_TYPE_URL: DSTADDR = new Uint8Array([3, address.length, ...encoder.encode(address)]); break;
        case ADDRESS_TYPE_IPV6: DSTADDR = new Uint8Array([4, ...address.split(':').flatMap(x => [parseInt(x.slice(0, 2), 16), parseInt(x.slice(2), 16)])]); break;
        default: throw new Error(E_INVALID_ADDR_TYPE);
    }
    await writer.write(new Uint8Array([5, 1, 0, ...DSTADDR, port >> 8, port & 255]));
    res = (await reader.read()).value;
    if (res[1] !== 0) throw new Error(E_SOCKS_CONN_FAIL);
    writer.releaseLock(); reader.releaseLock();
    return socket;
}

function parseSocksConfig(address) {
    let [latter, former] = address.split("@").reverse();
    let username, password, hostname, socksPort;

    if (former) {
        const formers = former.split(":");
        if (formers.length !== 2) throw new Error(E_INVALID_SOCKS_ADDR);
        [username, password] = formers;
    }

    const latters = latter.split(":");
    socksPort = Number(latters.pop());
    if (isNaN(socksPort)) throw new Error(E_INVALID_SOCKS_ADDR);

    hostname = latters.join(":");
    if (hostname.includes(":") && !/^\[.*\]$/.test(hostname)) throw new Error(E_INVALID_SOCKS_ADDR);

    return { username, password, hostname, socksPort };
}

