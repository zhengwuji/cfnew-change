// 图片代理接口 - 抓取javbus封面并返回图片
async function handleImageProxy(request) {
    const url = new URL(request.url);
    const code = url.searchParams.get('code');

    if (!code) {
        logHTTPError(400, 'Missing code', 'handleImageProxy', {
            url: url.pathname,
            method: request.method,
            workerRegion: currentWorkerRegion || 'unknown'
        });
        return new Response('Missing code', { status: 400 });
    }

    try {
        // 访问javbus获取封面URL
        const javbusUrl = 'https://www.javbus.com/' + code;
        const response = await fetch(javbusUrl, {
            headers: {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
            }
        });

        if (!response.ok) {
            logHTTPError(500, 'Failed to fetch', 'handleImageProxy', {
                url: url.pathname,
                method: request.method,
                workerRegion: currentWorkerRegion || 'unknown'
            });
            return new Response('Failed to fetch', { status: 500 });
        }

        const html = await response.text();
        const imgMatch = html.match(/<a[^>]+class="bigImage"[^>]*><img[^>]+src="([^"]+)"/);

        if (!imgMatch) {
            logHTTPError(404, 'Image not found', 'handleImageProxy', {
                url: url.pathname,
                method: request.method,
                workerRegion: currentWorkerRegion || 'unknown'
            });
            return new Response('Image not found', { status: 404 });
        }

        let imageUrl = imgMatch[1];
        if (!imageUrl.startsWith('http')) {
            imageUrl = 'https:' + imageUrl;
        }

        // 代理图片（解决CORS问题）
        const imageResponse = await fetch(imageUrl, {
            headers: {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Referer': 'https://www.javbus.com/'
            }
        });

        if (!imageResponse.ok) {
            logHTTPError(500, 'Image fetch failed', 'handleImageProxy', {
                url: url.pathname,
                method: request.method,
                workerRegion: currentWorkerRegion || 'unknown'
            });
            return new Response('Image fetch failed', { status: 500 });
        }

        // 返回图片，设置CORS头
        return new Response(imageResponse.body, {
            headers: {
                'Content-Type': imageResponse.headers.get('Content-Type') || 'image/jpeg',
                'Access-Control-Allow-Origin': '*',
                'Cache-Control': 'public, max-age=86400'
            }
        });
    } catch (error) {
        logError(error, 'handleImageProxy', {
            url: url.pathname,
            method: request.method,
            workerRegion: currentWorkerRegion || 'unknown'
        });
        return new Response('Error: ' + error.message, { status: 500 });
    }
}

async function fetchAndParseWetest(url) {
