                                    testResults.push(result);
                                    renderResult(result, idx);
                                    completed++;
                                }
                            }
                        }
                        
                        testStatus.textContent = '测试完成: ' + completed + '/' + total;
                        startTestBtn.style.display = 'inline-block';
