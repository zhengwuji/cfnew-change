    const yxbyControl = getConfigValue('yxby', '');
    if (yxbyControl && yxbyControl.toLowerCase() === 'yes') {
        disablePreferred = true;
    } else {
        disablePreferred = false;
    }

    const defaultURL = 'https://zip.cm.edu.kg/all.txt';
    if (piu !== defaultURL) {
