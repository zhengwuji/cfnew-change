            // 下载错误日志
            async function downloadErrorLogs() {
                try {
                    const btn = document.getElementById('downloadErrorLogsBtn');
                    if (btn) {
                        btn.disabled = true;
                        btn.textContent = '下载中...';
                    }
                    
                    let basePath = window.location.pathname;
                    if (basePath.endsWith('/')) {
                        basePath = basePath.slice(0, -1);
                    }
                    const response = await fetch(basePath + '/api/error-logs?limit=1000');
                    if (!response.ok) {
                        throw new Error('获取日志失败: ' + response.status);
                    }
                    
                    const data = await response.json();
                    const logs = data.logs || [];
                    
                    if (logs.length === 0) {
                        alert('当前没有错误日志');
                        if (btn) {
                            btn.disabled = false;
                            btn.textContent = '📥 下载日志';
                        }
                        return;
                    }
                    
                    // 格式化日志为文本
                    const logText = logs.map(log => {
                        let text = '[' + log.timestamp + '] [' + log.context + '] ' + log.message;
                        if (log.stack) {
                            text += '\\n堆栈:\\n' + log.stack;
                        }
                        if (log.url) {
                            text += '\\nURL: ' + log.url;
                        }
                        if (log.method) {
                            text += '\\n方法: ' + log.method;
                        }
                        if (log.workerRegion) {
                            text += '\\n地区: ' + log.workerRegion;
                        }
                        return text;
                    }).join('\\n\\n' + '='.repeat(80) + '\\n\\n');
                    
                    // 创建下载
                    const dataBlob = new Blob([logText], { type: 'text/plain; charset=utf-8' });
                    const url = URL.createObjectURL(dataBlob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = 'error-logs-' + new Date().toISOString().split('T')[0] + '-' + Date.now() + '.txt';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);
                    
                    // 同时下载JSON格式
                    const jsonBlob = new Blob([JSON.stringify(logs, null, 2)], { type: 'application/json; charset=utf-8' });
                    const jsonUrl = URL.createObjectURL(jsonBlob);
                    const jsonLink = document.createElement('a');
                    jsonLink.href = jsonUrl;
                    jsonLink.download = 'error-logs-' + new Date().toISOString().split('T')[0] + '-' + Date.now() + '.json';
                    document.body.appendChild(jsonLink);
                    setTimeout(() => {
                        jsonLink.click();
                        document.body.removeChild(jsonLink);
                        URL.revokeObjectURL(jsonUrl);
                    }, 300);
                    
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = '📥 下载日志';
                    }
                    
                    alert('错误日志已下载（TXT和JSON格式）');
                } catch (error) {
                    alert('下载失败: ' + error.message);
                    const btn = document.getElementById('downloadErrorLogsBtn');
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = '📥 下载日志';
                    }
                }
            }
            
